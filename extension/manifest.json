{
  "manifest_version": 3,
  "name": "Jev Ad Filter",
  "version": "0.1.0",
  "description": "Jev API でページ要素を判定し、広告を非表示にします（ローカル中継サーバーが必要）",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Jev Ad Filter", "default_popup": "popup.html" }
}
